    "test:customer:browser": "node test/customer-editor-browser.mjs",
    "test:customer": "node --test test/customer-editor.test.mjs",
    "dev:customer": "node scripts/customer-preview.mjs",
    "test:publishing:permissions": "node --test test/customer-publishing.test.mjs",
    "test:publishing:browser": "node test/customer-publishing-browser.mjs"
  },
  "dependencies": {
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "miniflare": "5.20261012.0-beta",
    "wrangler": "^4.42.0"
  }
}
