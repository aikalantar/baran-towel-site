    "test:builder": "node test/builder-browser.mjs",
    "test:builder:publish": "node test/builder-publish-browser.mjs",
    "test:release:runtime": "npm run deploy:check && node test/release-runtime.mjs",
    "test:release:browser": "node test/release-browser.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:browser": "node test/cms-browser.mjs",
    "test:runtime": "npm run deploy:check && node test/cms-runtime.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:builder:pro": "node test/freeform-browser.mjs",
    "dev:builder:review": "node scripts/builder-review.mjs",
    "test:builder:migration": "node test/migration-browser.mjs",
    "test:builder:blocks": "node test/task6-blocks-browser.mjs",
    "test:builder:pages": "node test/task6-pages-browser.mjs",
    "test:performance:local": "node test/performance-local.mjs",
    "test:builder:media": "node test/media-ratio-browser.mjs",
    "test:builder:ux": "node test/customer-ux-browser.mjs",
    "test:stabilization:browser": "node test/stabilization-browser.mjs",
    "test:navigation:pwa": "npm run deploy:check && node test/navigation-pwa-browser.mjs",
    "test:builder:direct": "node test/direct-edit-browser.mjs",
    "test:builder:fonts": "node test/font-publish-browser.mjs",
    "test:interop": "node --test test/identity-interop.test.mjs",
