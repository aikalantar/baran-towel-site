/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Canonical HTML always revalidates.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' about:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
/
  Cache-Control: public, max-age=0, must-revalidate
/catalog/
  Cache-Control: public, max-age=0, must-revalidate
/bridal-towels/
  Cache-Control: public, max-age=0, must-revalidate
/blog/
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
/en/
  Cache-Control: public, max-age=0, must-revalidate
/en/catalog/
  Cache-Control: public, max-age=0, must-revalidate
/en/blog/
  Cache-Control: public, max-age=0, must-revalidate
/en/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# Versioned brand and browser icons are immutable.
/styles.600f8d5159.css
  Cache-Control: public, max-age=31536000, immutable
/script.df5cebe557.js
  Cache-Control: public, max-age=31536000, immutable
/assets/images/brand/baran-logo.c01f592bc1.png
  Cache-Control: public, max-age=31536000, immutable
/assets/bridal/*
  Cache-Control: public, max-age=31536000, immutable
/favicon-v2.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon-*-v2.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon-v2.png
  Cache-Control: public, max-age=31536000, immutable
/icon-*-v2.png
  Cache-Control: public, max-age=31536000, immutable

# Keep the duplicate workers.dev hostname out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
