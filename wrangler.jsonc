{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baran-towel-site",
  "account_id": "4f0b7adeb50009560b1222d95529a824",
  "main": "src/cms-worker.js",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/cms/*", "/admin/builder", "/admin/builder/", "/admin/builder/index.html"],
  },
  "vars": {
    "CMS_REPOSITORY": "aikalantar/baran-towel-site",
    "CMS_BRANCH": "main",
  },
  "durable_objects": {
    "bindings": [{ "name": "CMS_GUARD", "class_name": "CMSLoginGuard" }],
  },
  "migrations": [{ "tag": "cms-v1", "new_sqlite_classes": ["CMSLoginGuard"] }],
}
